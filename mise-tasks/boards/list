#!/usr/bin/env bun
//MISE description="List your Trello boards as JSON"

import { runEndpoint } from "../../src/run-endpoint.ts";
import endpoints from "../../spec/read-endpoints.json";
import type { Endpoint } from "../../src/endpoint.ts";

const endpoint = endpoints.find((item) => item.path === "/1/members/{id}/boards") as Endpoint;
await runEndpoint({
  ...endpoint,
  task: "boards:list",
  path: "/1/members/me/boards",
  parameters: endpoint.parameters.filter((parameter) => parameter.location !== "path"),
});
